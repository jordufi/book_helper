# Copiar a .env y ajustar si hace falta.
# El .env real está gitignored.

# --- Postgres ---
POSTGRES_USER=bookhelper
POSTGRES_PASSWORD=bookhelper
POSTGRES_DB=book_helper
POSTGRES_PORT=5432

# --- API (Express + Prisma) ---
# Usada por Prisma. El host es localhost porque la API corre fuera de Docker.
DATABASE_URL=postgresql://bookhelper:bookhelper@localhost:5432/book_helper?schema=public
API_PORT=3000
UPLOADS_DIR=../uploads

# --- Frontend (Vite) ---
# Debe ser la IP de la máquina (no localhost) para poder abrirlo desde el móvil.
VITE_API_URL=http://localhost:3000
